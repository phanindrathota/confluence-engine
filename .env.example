# Copy to .env and fill in. Never commit .env.

# --- QuantData (required) ---
# Format: qd_ followed by 32 alphanumeric characters.
QUANTDATA_API_KEY=
QUANTDATA_BASE_URL=https://api.quantdata.us

# Our own ceiling on requests per minute. QuantData allows 240/min PER USER,
# shared with every key on the account (including your other agent).
# The collector also reads X-RateLimit-Remaining, so it backs off when the
# other agent is busy, but this cap keeps us polite by default.
QD_BUDGET_PER_MIN=150
# Stop sending when the shared bucket has this many requests or fewer left.
QD_RESERVE_REQUESTS=25

# --- Discord (optional; health reports) ---
DISCORD_WEBHOOK_HEALTH=

# --- Schwab (not used in Phase 0; reserved for live option quotes in Phase 2) ---
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_REFRESH_TOKEN=

# --- LLM judge (not used in Phase 0; reserved for Phase 3) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Storage ---
# Where bronze/silver/state live. Relative paths resolve from the repo root.
DATA_DIR=./data
LOG_LEVEL=INFO
